# ---- LLM: pick ONE (both work; set AI_PROVIDER if you have both) ----

# https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# OpenRouter — free models. https://openrouter.ai/keys
OPENROUTER_API_KEY=

# anthropic | openai | openrouter. Omit to auto-pick whichever key is set.
# Per-task provider and model are chosen in Settings and stored in the DB.
# AI_PROVIDER=anthropic

# Defaults are already the cheap tier for every task (~$0.55/search on
# Anthropic, ~$0.12 on OpenAI, $0 on OpenRouter). Change them in Settings.

# ---- Search (only used when your query has NO email address in it) ----

# Google results. 2,500 free searches/month. https://serper.dev
SERPER_API_KEY=

# Polite-pool identifier for OpenAlex. No signup — just your email address.
OPENALEX_MAILTO=subodhthallada@gmail.com

# Last-resort email finder, 50 free lookups/month. Optional. https://hunter.io
HUNTER_API_KEY=

# Exa — semantic search, small credit pool. Optional. https://exa.ai
# Never runs alongside Serper: it is only a fallback for when Serper is
# switched off or returns nothing. Off by default in Settings, and capped
# per search there so one run cannot drain the pool.
EXA_API_KEY=

# ---- Sending: Gmail via Google OAuth ----
# You connect your Gmail from Settings; no password is ever stored here.
#
# Setup, once, at console.cloud.google.com:
#   1. APIs & Services > Library > enable "Gmail API"
#   2. OAuth consent screen: External, add yourself under Test users
#   3. Credentials > Create OAuth client ID > Web application
#      Authorized redirect URIs:
#        http://localhost:3000/api/google/callback
#        https://<your-domain>/api/google/callback
#
# The app asks for gmail.send only — it can send as you, not read your mail.
# That is a "sensitive" scope: fine for up to 100 test users, but Google
# verification is required before opening it to the public.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Encrypts Google refresh tokens at rest (AES-256-GCM). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing it makes every connected account unreadable — reconnect after.
TOKEN_ENCRYPTION_KEY=

# ---- Database ----
# Local dev (default): a SQLite file.
DATABASE_URL=file:./data/app.db

# Supabase / any Postgres. REQUIRED for Vercel — its filesystem is ephemeral,
# so the SQLite file above cannot persist there.
# Supabase: Project Settings > Database > Connection string > "Transaction pooler"
# DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Turso (hosted libsql) as an alternative to Postgres:
# DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=

# ---- Login (required before you publish a public URL) ----
# Supabase project with the Google provider enabled under
# Authentication > Providers. Add <your-domain>/auth/callback to its
# redirect allowlist. Local development runs without login.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Comma-separated. Empty means ANY Google account can sign in — set it.
ALLOWED_EMAILS=subodhthallada@gmail.com

# ---- Scheduled sending ----
# Gmail's own "schedule send" is a feature of the Gmail website, not the Gmail
# API, so there is nothing to hand off to: scheduled mail waits in this app's
# outbox and a cron job releases it.
#
# Required for the "send at a time" and "next peak time" options. The cron
# endpoint refuses to run without it. Vercel Cron sends it as
# `Authorization: Bearer <secret>`.
CRON_SECRET=

# ---- Public origin ----
# Also where read-receipt pixels point. Tracking is skipped entirely when this
# is unset or points at localhost, because a localhost pixel in a stranger's
# inbox records nothing. Set it to the deployed URL before enabling receipts.
APP_URL=http://localhost:3000
