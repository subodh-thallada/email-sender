# ---- LLM: pick ONE (both work; set AI_PROVIDER if you have both) ----

# https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# anthropic | openai. Omit to auto-pick whichever key is set (Anthropic first).
# AI_PROVIDER=anthropic

# Cheaper model for the high-volume page-extraction step only. Parsing and
# drafting stay on the flagship either way.
#   Anthropic: claude-haiku-4-5   (~$0.60/search vs ~$2.50)
#   OpenAI:    gpt-5.6-luna       (~$0.10/search vs ~$2.50)
# EXTRACTION_MODEL=

# ---- Search (only used when your query has NO email address in it) ----

# Google results. 2,500 free searches/month. https://serper.dev
SERPER_API_KEY=

# Polite-pool identifier for OpenAlex. No signup — just your email address.
OPENALEX_MAILTO=subodhthallada@gmail.com

# Last-resort email finder, 50 free lookups/month. Optional. https://hunter.io
HUNTER_API_KEY=

# ---- Sending ----
GMAIL_USER=
# 16-character Google App Password (NOT your account password).
# Requires 2-Step Verification: Account > Security > 2-Step Verification > App passwords
GMAIL_APP_PASSWORD=

# ---- Database ----
# Local dev (default): a SQLite file.
DATABASE_URL=file:./data/app.db

# Supabase / any Postgres. REQUIRED for Vercel — its filesystem is ephemeral,
# so the SQLite file above cannot persist there.
# Supabase: Project Settings > Database > Connection string > "Transaction pooler"
# DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Turso (hosted libsql) as an alternative to Postgres:
# DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=
