# ---- Required ----

# Anthropic API key — query parsing, page extraction, email drafting.
# https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# Google search, used to locate faculty/homepages. 2,500 free searches/month.
# https://serper.dev
SERPER_API_KEY=

# Polite-pool identifier for OpenAlex. No signup — just your email address.
# Gets you the faster rate-limit pool.
OPENALEX_MAILTO=subodhthallada@gmail.com

# ---- Optional ----

# Neural/semantic search. $10 free credits per month, no card required.
# Used for the corporate/alumni routes. https://exa.ai
EXA_API_KEY=

# Last-resort email finder, 50 free lookups/month. https://hunter.io
HUNTER_API_KEY=

# ---- Sending ----
# Gmail address you send from.
GMAIL_USER=
# 16-character Google App Password (NOT your account password).
# Requires 2-Step Verification enabled:
# Google Account > Security > 2-Step Verification > App passwords
GMAIL_APP_PASSWORD=

# ---- Storage ----
# Local SQLite file. Swap for a Turso URL + auth token to deploy.
DATABASE_URL=file:./data/app.db
# TURSO_AUTH_TOKEN=
